---
interface Props {
  title: string;
  description: string;
  href?: string;
  available?: boolean;
  eta?: string;
}

const { title, description, href, available = true, eta } = Astro.props;

const isLink = Boolean(href && available);
const Wrapper = isLink ? 'a' : 'div';
---

<Wrapper
  href={isLink ? href : undefined}
  class:list={[
    'group flex h-full flex-col rounded-lg border p-6 transition-colors',
    available ? 'border-gray-200 bg-white' : 'border-gray-100 bg-gray-50',
    isLink
      ? 'hover:border-blue-400 hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2'
      : '',
  ]}
>
  <h3 class:list={[
    'text-lg font-semibold transition-colors',
    available ? 'text-gray-900' : 'text-gray-400',
    isLink ? 'group-hover:text-blue-600' : '',
  ]}>
    {title}
  </h3>
  <p class:list={[
    'mt-2 text-sm',
    available ? 'text-gray-600' : 'text-gray-400',
  ]}>
    {description}
  </p>
  {!available && (
    <span class="mt-auto pt-4 inline-block text-xs font-medium text-gray-400 uppercase tracking-wide">
      {eta ? `Expected ${eta}` : 'Coming soon'}
    </span>
  )}
</Wrapper>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Slug for per-term anchors, so chapters can deep-link a definition.
const slug = (term) =>
  term.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

const groups = [
  {
    heading: 'The methodology',
    terms: [
      {
        term: 'Scientific Agentic Engineering (SAE)',
        def:
          'Applying agentic engineering to scientific software, so that a result produced with AI assistance can be checked, reproduced, and defended.',
      },
      {
        term: 'Agentic engineering',
        def:
          'Directing AI agents that plan, act, and use tools, rather than writing every line yourself.',
      },
      {
        term: 'Validation loop',
        def:
          'The first principle: a check at each decision point that can actually fail and whose result gates what proceeds, so that errors are caught where they are made rather than where they surface. For scientific work, what the check contains comes from domain-specific safeguards.',
      },
      {
        term: 'Human-in-the-loop oversight',
        def:
          'The second principle: concentrate human review on the decisions that matter, and accept lighter review elsewhere. Which decisions those are is project-specific; the recurring cases are decisions later work inherits without re-examining, and decisions that steer the agent itself.',
      },
      {
        term: 'Provenance',
        def:
          'The third principle: the record of where code, data, and decisions came from — including which parts an agent produced, and who approved them — kept as the work happens. Reproducibility of an AI-assisted result depends on it.',
      },
      {
        term: 'Context discipline',
        def:
          'The fourth principle: keep each actor working from what its task needs — current, and no more. Fresh context, scoped sub-agents, and clearing a spent session all serve it. Its absence is context bloat and scope drift, where stale or excess context corrupts a result that still looks right.',
      },
      {
        term: 'Domain-specific safeguard',
        def:
          'The fifth principle, and the one scientific work adds: checks that only make sense in a scientific context — physics checks, precision tests, bound checks, scope-drift containment.',
      },
    ],
  },
  {
    heading: 'The building blocks',
    terms: [
      {
        term: 'Agent',
        def:
          'An AI system that pursues a goal by planning and taking actions — reading files, running commands, calling tools — rather than only emitting text for a human to act on. On this site the term means development agents working in a workspace you control; general-purpose assistants that act across applications and accounts carry a different security surface and are out of scope here.',
      },
      {
        term: 'Sub-agent',
        def:
          'A scoped agent launched by a session to carry out a bounded task, typically with restricted tools and a fresh context. Isolation is the point: it cannot confirm reasoning it never saw.',
      },
      {
        term: 'Skill',
        def:
          'A packaged, reusable capability an agent can invoke by name — for example a unit checker or a conservation-law validator.',
      },
      {
        term: 'MCP server (Model Context Protocol)',
        def:
          'A standard interface that exposes tools and data to an agent — reading a dataset, querying a catalog, calling an instrument API.',
      },
      {
        term: 'Tool use',
        def:
          'An agent calling an external function instead of answering from recall.',
      },
      {
        term: 'Context',
        def:
          'The working memory of a session: everything the model can currently see. It is finite.',
      },
    ],
  },
  {
    heading: 'Ways of working',
    terms: [
      {
        term: 'Planning mode',
        def:
          'The agent proposes what it intends to do and waits for approval before acting.',
      },
      {
        term: 'Guard-railed session',
        def:
          'A session the human drives, launching scoped sub-agents, kept sandboxed and local, with human approval on the decisions that matter.',
      },
      {
        term: 'Autonomous hand-off',
        def:
          'A long-running agent acting broadly on its own with few checkpoints before it acts. The most convenient mode of work, and the one that puts the most weight on checks set up in advance.',
      },
    ],
  },
  {
    heading: 'Failure modes',
    intro:
      'Some of these produce a wrong result that survives every check; others spend review in the wrong place or widen what a mistake touches. What they share is that a general-purpose workflow is not looking for them. The framework chapter on how scientific code fails works through each.',
    terms: [
      {
        term: 'Unit confusion',
        def:
          'Quantities combined or converted in the wrong units, so that valid arithmetic produces a physically wrong answer.',
      },
      {
        term: 'Precision loss',
        def:
          'Numerically careless operations — catastrophic cancellation, recomputation from rounded intermediates — that degrade a result without breaking anything.',
      },
      {
        term: 'Subtle physics violations',
        def:
          'Code that runs and returns plausible numbers while breaking a conservation law, a boundary condition, or a physical bound.',
      },
      {
        term: 'Visualization misinterpretation',
        def:
          'A plot that is technically produced from the data and still tells the reader something false — mislabeled units, a misleading colormap, a truncated axis.',
      },
      {
        term: 'Context bloat',
        def:
          'Long sessions drift as the window fills; key details get buried and quality slips without an error message.',
      },
      {
        term: 'Over-trust',
        def:
          'Quietly wrong output reads exactly like correct output, so an answer’s confidence is not evidence of its accuracy. The check has to come from outside the context that produced the answer.',
      },
      {
        term: 'Scope drift',
        def:
          'An agent’s work creeping beyond the task it was given. Contained by scoping tightly and resetting deliberately.',
      },
    ],
  },
];
---

<BaseLayout
  title="Glossary — Scientific Agentic Engineering"
  description="Shared vocabulary for Scientific Agentic Engineering: agents, skills, MCP servers, validation loops, oversight, and the failure modes that matter in scientific code."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900">Glossary</h1>

    <p class="mt-4 text-gray-600 leading-relaxed">
      These are the terms used across this project, defined as they are used here
      rather than as any one vendor defines them.
    </p>

    <p class="mt-3 text-sm text-gray-500 leading-relaxed">
      Published with Milestone 1 (July 2026) and revised alongside the framework
      draft as the fellowship proceeds.
    </p>

    <div class="mt-10 space-y-12">
      {groups.map(({ heading, intro, terms }) => (
        <section>
          <h2 class="text-xl font-semibold text-gray-900 pb-2 border-b border-gray-200">{heading}</h2>
          {intro && <p class="mt-3 text-gray-600 leading-relaxed">{intro}</p>}
          <dl class="mt-5 space-y-5">
            {terms.map(({ term, def }) => (
              <div
                id={slug(term)}
                class="scroll-mt-24 -ml-3 border-l-2 border-transparent pl-3 transition-colors target:border-blue-600 target:bg-blue-50"
              >
                <dt class="font-semibold text-gray-900">{term}</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">{def}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <p class="mt-12 text-gray-600 leading-relaxed">
      New to this? Start with the <a href={`${base}overview/`} class="text-blue-600 hover:underline">Overview</a>.
    </p>
  </div>

</BaseLayout>

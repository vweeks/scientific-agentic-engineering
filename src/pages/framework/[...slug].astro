---
import FrameworkLayout from '../../layouts/FrameworkLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('framework')).filter(entry => !entry.data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<FrameworkLayout title={entry.data.title} description={entry.data.description} slug={entry.id} headings={headings}>
  <Content />
</FrameworkLayout>

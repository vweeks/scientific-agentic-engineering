---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Scientific Agentic Engineering">
  <Hero />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <FeatureCard
        title="Overview"
        description="How to work with AI agents on scientific code without giving up rigor: the common ways of working, and the check each one needs."
        href={`${base}overview/`}
      />
      <FeatureCard
        title="Framework"
        description="Principles and patterns for responsible AI-agent integration in scientific software development."
        href={`${base}framework/`}
      />
      <FeatureCard
        title="Glossary"
        description="Shared vocabulary for the field — agents, skills, MCP servers, validation loops, and the failure modes that matter in scientific code."
        href={`${base}glossary/`}
      />
      <FeatureCard
        title="Community Catalog"
        description="Scientific MCP server templates, skills such as unit checkers and conservation-law validators, and agent configuration examples."
        available={false}
        eta="October 2026"
      />
      <FeatureCard
        title="Tutorials"
        description="“Building Your First Scientific Agent” — a hands-on series building a validated agent for the reference workflow."
        available={false}
        eta="January 2027"
      />
      <FeatureCard
        title="Workshops"
        description="Recordings and materials from community events, webinars, and training sessions."
        available={false}
        eta="April 2027"
      />
    </div>
  </section>
</BaseLayout>

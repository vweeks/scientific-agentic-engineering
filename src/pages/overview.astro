---
import BaseLayout from '../layouts/BaseLayout.astro';
import OverviewToc from '../components/OverviewToc.astro';

const base = import.meta.env.BASE_URL;

// "On this page" sections — order and slugs must match the H2 ids below and
// drive both the sidebar TOC and the scroll-spy in OverviewToc.astro.
const sections = [
  { slug: 'why-different', text: 'Why scientific code is different' },
  { slug: 'where-people-stand', text: 'Where people stand' },
  { slug: 'where-ai-meets-code', text: 'Where AI meets your code' },
  { slug: 'what-building', text: 'What this project is building' },
  { slug: 'what-not', text: 'What this project is not' },
  { slug: 'tool-agnostic', text: 'Why the framework is tool-agnostic' },
  { slug: 'where-next', text: 'Where to go next' },
];

// Interaction types, ordered by how much of your codebase the tool can see
// (access 1–3). This replaces the old five-"stages" ladder: the differentiator
// is integration/access, not "how advanced." Capability depth (tool use,
// planning, autonomous agents) and the agency-vs-autonomy distinction live in
// the framework and glossary, not here.
const interactionTypes = [
  {
    name: 'Tab-complete',
    where: 'In your editor',
    access: 1,
    what: 'Your editor suggests the next line or block from the code right around your cursor. Fast and local — it does not know the rest of your project.',
    eg: 'the gray ghost-text your editor offers as you type.',
  },
  {
    name: 'Chat assistant',
    where: 'In a chat window',
    access: 2,
    what: 'You describe the problem and paste in code or an error; you copy the answer back by hand. It sees exactly what you give it, and nothing else.',
    eg: 'pasting a function and a stack trace into a chat, in the browser or an app.',
  },
  {
    name: 'Coding assistant',
    where: 'In your project',
    access: 3,
    what: 'It works inside your project — opening files, running commands, using tools and skills. The fullest access, and the most it can do without you moving anything by hand.',
    eg: 'an assistant you point at a repo and ask to make a change end to end.',
  },
];

const surfaces = ['IDE extension', 'Web app', 'Terminal CLI', 'Desktop app'];

const failureModes = [
  'Unit confusion',
  'Precision loss',
  'Subtle physics violations',
  'Visualization misinterpretation',
];

const risks = [
  {
    name: 'Context bloat',
    line: 'More context != more signal.',
    body:
      'Long sessions drift as the window fills. Details you set early get buried, and nothing warns you when they do.',
  },
  {
    name: 'Over-trust',
    line: 'Fluent != correct.',
    body:
      'Confident output that is quietly wrong is easy to miss — nothing in the tone of an answer tells you which you are looking at.',
  },
  {
    name: 'Prompt injection',
    line: 'Fetched != trusted.',
    security: true,
    body:
      'An assistant that reads issues, web pages, or data files can be steered by instructions hidden in them. What it fetches is not automatically trustworthy.',
  },
];

// Four facets of where someone stands on AI-augmented development. Three run
// "outward is the direction the project encourages"; trust is centered, where
// the healthy target is the middle (calibrated), not an end. Keys are the
// stable backend contract (see workers/overview-poll) — labels can change
// without a Cloudflare edit; keys cannot.
const pollAxes = [
  { key: 'familiarity', label: 'Familiarity', left: 'Unaware', right: 'Fluent', goal: 'up' },
  { key: 'adoption', label: 'Adoption', left: 'Not using', right: 'Daily use', goal: 'up' },
  { key: 'keepingup', label: 'Keeping up', left: 'Overwhelmed', right: 'Steady', goal: 'up' },
  { key: 'trust', label: 'Trust', left: 'Blanket rejection', right: 'Blind trust', mid: 'Calibrated', goal: 'center' },
];
const POLL_PHASE = 'before';
const POLL_DEFAULT = 25;

// Radar geometry, precomputed so the skeleton renders server-side (styles apply
// cleanly, less client DOM-building). The client script recomputes the two data
// polygons on interaction with the same math. "health" makes further-from-center
// mean the encouraged direction on every axis, including centered trust.
const R_CX = 130, R_CY = 130, R_R = 92;
const radarPt = (i, hv) => {
  const ang = (-90 + i * 90) * Math.PI / 180;
  const r = (hv / 100) * R_R;
  return [R_CX + r * Math.cos(ang), R_CY + r * Math.sin(ang)];
};
const radarHealth = (goal, v) => (goal === 'center' ? 100 - Math.abs(v - 50) * 2 : v);
const fmtPts = (pts) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const radarRings = [25, 50, 75, 100].map(f => fmtPts(pollAxes.map((_, i) => radarPt(i, f))));
const radarSpokes = pollAxes.map((_, i) => radarPt(i, 100));
const radarLabels = pollAxes.map((a, i) => {
  const [x, y] = radarPt(i, 113);
  return {
    label: a.label, x, y,
    anchor: i === 1 ? 'start' : i === 3 ? 'end' : 'middle',
    baseline: i === 0 ? 'auto' : i === 2 ? 'hanging' : 'middle',
  };
});
const radarInit = fmtPts(pollAxes.map((a, i) => radarPt(i, radarHealth(a.goal, POLL_DEFAULT))));
const handleInit = pollAxes.map((a, i) => radarPt(i, radarHealth(a.goal, POLL_DEFAULT)));

// Milestone timeline for "What this project is building". Date-anchored: each
// milestone (Jul/Oct/Jan/Apr) holds the built deliverables that land then.
// Reference Workflow and the Milestone 3 items follow the SoW wording;
// dissemination activities (US-RSE report, blog, webinar) are intentionally
// not listed here — this section is about built artifacts.
const milestones = [
  {
    date: 'Jul 2026',
    items: [
      { name: 'The Framework', body: 'Tool-agnostic guidance for structuring agents, skills, and MCP servers in scientific workflows, organized around validation loops, human oversight, and domain-specific safeguards.' },
    ],
  },
  {
    date: 'Oct 2026',
    items: [
      { name: 'The Community Repository', body: 'A starter set of scientific MCP server templates, skills such as unit checkers and conservation-law validators, and agent configuration examples.' },
      { name: 'The Reference Workflow', body: 'A structured exercise: build a simple weather-model error-statistics application with the AI tools of your choice, applying the framework’s principles to avoid documented failure modes — unit confusion, visualization misinterpretation, and precision loss.' },
    ],
  },
  {
    date: 'Jan 2027',
    items: [
      { name: 'Interactive tutorial series', body: '“Building Your First Scientific Agent” — guiding you through the framework and repository tools to build a validated agent for the Reference Workflow.' },
      { name: 'Failure-mode examples', body: 'Static visual documentation of common failure modes — hallucinated physics, precision loss, unit confusion — drawn from real development experience, so the tutorials can focus on getting it right.' },
    ],
  },
  {
    date: 'Apr 2027',
    items: [
      { name: 'Live workshop', body: 'A live workshop following the reference workflow, with real-time Q&A — recorded and published for anyone who cannot attend.' },
    ],
  },
];

const notScope = [
  'It produces guidance and educational resources. It does not produce production-grade AI tools, and it does not maintain long-term software infrastructure.',
  '“Comprehensive methodology” means structured and principled. It does not mean exhaustive coverage of every scientific domain or every AI tool.',
  'The Community Repository is a curated starter set that demonstrates good practice. It is not a package registry or a software distribution platform.',
  'The project does not cover new numerical weather prediction models, commercially deployable agent systems, or maintenance of contributed tools beyond April 2027.',
];
---

<BaseLayout
  title="Overview — Scientific Agentic Engineering"
  description="What Scientific Agentic Engineering is for: the failure modes AI agents introduce in scientific software, the ways people work with these tools, and what this fellowship is and is not building."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:flex lg:gap-10">
    <!-- Desktop sidebar: "On this page" section nav + scroll-spy -->
    <aside class="hidden lg:block lg:w-52 lg:flex-none">
      <div class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pb-6 pr-1">
        <OverviewToc sections={sections} />
      </div>
    </aside>

    <!-- Content column -->
    <div class="min-w-0 lg:flex-1">
      <div class="max-w-3xl mx-auto lg:mx-0">
        <!-- Mobile disclosure: same TOC, collapsed by default -->
        <details class="lg:hidden mb-8 rounded-lg border border-gray-200 bg-gray-50/70">
          <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-gray-700 marker:text-gray-400">
            On this page
          </summary>
          <div class="border-t border-gray-200 px-4 py-3">
            <OverviewToc sections={sections} showLabel={false} />
          </div>
        </details>

        <h1 class="text-3xl font-bold text-gray-900">Overview</h1>

    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      AI coding agents got good quickly, and research software teams are already
      using them. The productivity is real, and so is the risk: scientific
      software can fail in ways that general-purpose tooling was never built to
      catch.
    </p>

    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      This fellowship teaches research software engineers to practice
      AI-augmented engineering effectively and safely — not simply to check an
      agent's output more carefully, but to work in ways that keep errors from
      slipping through in the first place. That means covering the kinds of AI
      tools available, the approaches that get the most out of them safely, and
      the classes of error those approaches are designed to mitigate.
    </p>

    <h2 id="why-different" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">Why scientific code is different</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      When code makes a wrong assumption — whether a person or an agent
      introduced it — most software eventually tells you. The build breaks, a
      test fails, or the wrong number turns up somewhere a human is watching.
      Scientific software often has no such backstop: the code runs, the tests
      pass, and you are left with <strong class="text-gray-900">corrupted results that still pass CI</strong>.
      Nothing downstream will correct you, so the only thing that catches a wrong
      answer is a check somebody decided to write. These failures are also among
      the easiest to miss when reviewing AI-written code: an agent does not make
      the mistakes you would make yourself, so they slip past the instincts a
      reviewer leans on. A few of the classes worth watching for:
    </p>

    <ul class="mt-4 flex flex-wrap gap-2">
      {failureModes.map(m => (
        <li class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">{m}</li>
      ))}
    </ul>

    <p class="mt-4 text-gray-600 leading-relaxed">
      Reproducibility erodes the same way. A result whose derivation was never
      written down cannot be checked by anyone who was not in the room.
    </p>

    <h2 id="where-people-stand" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">Where people stand</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      Research software has not settled on these tools, and reactions to them are
      not binary. The four axes below are one way to place yourself.
    </p>

    <div id="standing-poll" class="mt-6 rounded-lg border border-gray-200 p-5" data-phase={POLL_PHASE} hidden>
      <div class="flex items-baseline justify-between gap-3 flex-wrap">
        <h3 class="font-semibold text-gray-900">Place yourself</h3>
        <span id="poll-count" class="text-xs uppercase tracking-wide text-gray-400"></span>
      </div>
      <p class="mt-1 text-sm text-gray-600 leading-relaxed">
        Anonymously rate your own sentiment toward AI-augmented development
        tools. Whatever your starting point, this project hopes to widen your
        coverage on every axis.
      </p>

      <div class="poll-rig mt-5">
        <div class="poll-radar-wrap">
          <svg class="poll-radar" viewBox="-40 -40 340 340" role="img" aria-label="A four-axis shape of your response. Further from the center is the direction this project encourages: more familiarity, more adoption, steadier footing, and calibrated trust.">
            <g>
              {radarRings.map((pts, idx) => (
                <polygon points={pts} class={idx === radarRings.length - 1 ? 'poll-ring poll-ring--outer' : 'poll-ring'} />
              ))}
              {radarSpokes.map(([x, y]) => (
                <line x1={R_CX} y1={R_CY} x2={x.toFixed(1)} y2={y.toFixed(1)} class="poll-spoke" />
              ))}
            </g>
            <polygon class="poll-poly-community" points="" hidden></polygon>
            <polygon class="poll-poly-you" points={radarInit}></polygon>
            <g class="poll-handles">
              {handleInit.map(([x, y]) => (
                <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="3.5" class="poll-handle" />
              ))}
            </g>
            <g>
              {radarLabels.map(({ label, x, y, anchor, baseline }) => (
                <text x={x.toFixed(1)} y={y.toFixed(1)} text-anchor={anchor} dominant-baseline={baseline}>{label}</text>
              ))}
            </g>
          </svg>
          <p class="poll-goal-note">Further out = the direction this project encourages.</p>
        </div>

        <div class="poll-axes">
          {pollAxes.map(({ key, label, left, right, mid, goal }) => (
            <div class={goal === 'center' ? 'poll-axis poll-axis--center' : 'poll-axis'}>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-xs text-gray-400">{left}</span>
                <span class="text-sm font-medium text-gray-700">{label}{mid && <span class="poll-target"> ▸ {mid}</span>}</span>
                <span class="text-xs text-gray-400 text-right">{right}</span>
              </div>
              <input type="range" min="0" max="100" value={POLL_DEFAULT} data-axis={key} data-goal={goal}
                     aria-label={mid ? `${label}: ${left} to ${right}, healthy at the center (${mid})` : `${label}: ${left} to ${right}`}
                     class="poll-range mt-2 w-full" />
            </div>
          ))}
        </div>
      </div>

      <div class="mt-5 flex items-center gap-4 flex-wrap">
        <button id="poll-submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50 disabled:hover:bg-blue-600">
          Add your response
        </button>
        <p id="poll-status" class="text-sm text-gray-500" aria-live="polite"></p>
      </div>
    </div>

    <script define:vars={{
      axes: pollAxes.map(a => ({ key: a.key, goal: a.goal })),
      phase: POLL_PHASE,
      CX: R_CX, CY: R_CY, RAD: R_R,
      endpoint: 'https://sae-overview-poll.vweeks-c17.workers.dev',
    }}>
      const root = document.getElementById('standing-poll');
      const btn = document.getElementById('poll-submit');
      const statusEl = document.getElementById('poll-status');
      const countEl = document.getElementById('poll-count');

      if (root && btn) {
        const polyYou = root.querySelector('.poll-poly-you');
        const polyCommunity = root.querySelector('.poll-poly-community');
        const handles = root.querySelectorAll('.poll-handle');
        const ranges = root.querySelectorAll('input[type="range"]');
        const DONE_KEY = `sae-overview-poll-done-${phase}`;

        const health = (goal, v) => (goal === 'center' ? 100 - Math.abs(v - 50) * 2 : v);
        const pt = (i, hv) => {
          const a = (-90 + i * 90) * Math.PI / 180, r = (hv / 100) * RAD;
          return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
        };
        const pointsFrom = (valueOf) =>
          axes.map((ax, i) => pt(i, health(ax.goal, valueOf(ax.key))).map(n => n.toFixed(1)).join(',')).join(' ');

        const state = {};
        axes.forEach((ax, i) => { state[ax.key] = Number(ranges[i].value); });

        function renderYou() {
          polyYou.setAttribute('points', pointsFrom(k => state[k]));
          axes.forEach((ax, i) => {
            const [x, y] = pt(i, health(ax.goal, state[ax.key]));
            handles[i].setAttribute('cx', x.toFixed(1));
            handles[i].setAttribute('cy', y.toFixed(1));
          });
        }
        ranges.forEach(inp => inp.addEventListener('input', () => {
          state[inp.dataset.axis] = Number(inp.value);
          renderYou();
        }));
        renderYou();

        function showCommunity(averages) {
          if (!averages || !axes.every(ax => averages[ax.key] != null)) return;
          polyCommunity.setAttribute('points', pointsFrom(k => averages[k]));
          polyCommunity.hidden = false;
        }
        function setCount(n) {
          if (countEl && n > 0) countEl.textContent = `${n} response${n === 1 ? '' : 's'} so far`;
        }
        function markDone(message) {
          ranges.forEach(i => (i.disabled = true));
          btn.disabled = true;
          if (statusEl) statusEl.textContent = message;
        }
        const alreadyDone = () => {
          try { return localStorage.getItem(DONE_KEY) === '1'; } catch { return false; }
        };

        async function init() {
          let data;
          try {
            const res = await fetch(`${endpoint}/aggregate`);
            if (!res.ok) return; // backend down or retired: leave the widget hidden
            data = await res.json();
          } catch { return; }
          const mine = data?.phases?.[phase] || { count: 0, averages: null };
          root.hidden = false;
          setCount(mine.count);
          if (alreadyDone()) { showCommunity(mine.averages); markDone('You have already added yours.'); }
        }

        async function submit() {
          btn.disabled = true;
          const body = { phase };
          ranges.forEach(i => { if (i.dataset.axis) body[i.dataset.axis] = Number(i.value); });
          try {
            const res = await fetch(`${endpoint}/response`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (res.status === 429) {
              markDone('Daily limit reached from your network — try again tomorrow.');
              return;
            }
            if (!res.ok) throw new Error(String(res.status));
            const data = await res.json();
            try { localStorage.setItem(DONE_KEY, '1'); } catch { /* private mode */ }
            const mine = data?.phases?.[phase];
            if (mine) { setCount(mine.count); showCommunity(mine.averages); }
            markDone('Thanks — added.');
          } catch {
            btn.disabled = false;
            if (statusEl) statusEl.textContent = 'Could not reach the poll service — your response may not have been recorded.';
          }
        }

        btn.addEventListener('click', submit);
        init();
      }
    </script>

    <p class="mt-3 text-gray-600 leading-relaxed">
      This project is aimed at that whole spread, not one point in it.
    </p>

    <h2 id="where-ai-meets-code" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">Where AI meets your code</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      People reach for AI on code in a handful of ways. What separates them is
      <strong class="text-gray-900">how much of your codebase the tool can see</strong>,
      and what it is allowed to do there.
    </p>

    <div class="mt-6 space-y-4">
      {interactionTypes.map(({ name, where, access, what, eg }) => (
        <div class="rounded-lg border border-gray-200 p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-baseline gap-3 flex-wrap">
              <h3 class="font-semibold text-gray-900">{name}</h3>
              <span class="text-xs uppercase tracking-wide text-gray-400">{where}</span>
            </div>
            <div class="shrink-0 text-right">
              <span class="block text-[0.6rem] uppercase tracking-wide text-gray-400 mb-1">Codebase access</span>
              <span class="inline-flex gap-1 justify-end">
                {[1, 2, 3].map(i => (
                  <span class:list={['inline-block h-1.5 w-4 rounded-sm', i <= access ? 'bg-blue-600' : 'bg-gray-200']} aria-hidden="true"></span>
                ))}
              </span>
            </div>
          </div>
          <p class="mt-2 text-gray-600 leading-relaxed">{what}</p>
          <p class="mt-2 text-sm text-gray-400"><span class="font-medium text-gray-500">Looks like:</span> {eg}</p>
        </div>
      ))}
    </div>

    <h3 class="mt-10 font-semibold text-gray-900">And it turns up in different places</h3>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The same coding assistant can run on several surfaces, to fit how you already work.
    </p>

    <ul class="mt-4 flex flex-wrap gap-2">
      {surfaces.map(s => (
        <li class="rounded-full bg-gray-50 border border-gray-200 px-3 py-1 text-sm text-gray-600">{s}</li>
      ))}
    </ul>

    <h3 class="mt-10 font-semibold text-gray-900">A few general risks</h3>

    <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-5">
      {risks.map(({ name, line, body, security }) => (
        <div class="rounded-lg border border-gray-200 p-5">
          <h4 class="font-semibold text-gray-900">{name}</h4>
          <p class:list={['mt-1 text-sm font-medium', security ? 'text-amber-700' : 'text-blue-600']}>{line}</p>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <h2 id="what-building" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">What this project is building</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The fellowship runs from April 2026 to April 2027. Four milestones mark what
      it builds — select one to see what lands.
    </p>

    <div id="build-timeline" class="mt-6">
      <div class="tl" role="tablist" aria-label="Project milestones">
        <div class="tl-line" aria-hidden="true"></div>
        {milestones.map((m, i) => (
          <button type="button" class="tl-node" role="tab" id={`tl-tab-${i}`} aria-controls={`tl-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="tl-dot" aria-hidden="true"></span>
            <span class="tl-date">{m.date}</span>
          </button>
        ))}
      </div>
      <div class="tl-panels">
        {milestones.map((m, i) => (
          <div class="tl-panel" id={`tl-panel-${i}`} role="tabpanel" aria-labelledby={`tl-tab-${i}`}>
            <span class="tl-when">{m.date}</span>
            {m.items.map(it => (
              <div class="tl-item">
                <h3 class="tl-item-name">{it.name}</h3>
                <p class="tl-item-body">{it.body}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <p class="mt-6 text-gray-600 leading-relaxed">
      The aim throughout is to turn broad AI capability into development you can
      account for: work you can point at real problems and defend afterward, step
      by step.
    </p>

    <script>
      // Milestone timeline — ARIA tablist with roving tabindex. Progressive
      // enhancement: panels render server-side (all visible without JS); this
      // collapses them to one and wires click / hover / arrow-key selection.
      const tlRoot = document.getElementById('build-timeline');
      if (tlRoot) {
        const tlNodes = [...tlRoot.querySelectorAll<HTMLButtonElement>('.tl-node')];
        const tlPanels = [...tlRoot.querySelectorAll<HTMLElement>('.tl-panel')];
        const tlSelect = (i: number, focus: boolean) => {
          tlNodes.forEach((n, j) => {
            const on = j === i;
            n.setAttribute('aria-selected', on ? 'true' : 'false');
            n.tabIndex = on ? 0 : -1;
            tlPanels[j].hidden = !on;
          });
          if (focus) tlNodes[i].focus();
        };
        tlNodes.forEach((n, i) => {
          n.addEventListener('click', () => tlSelect(i, false));
          n.addEventListener('mouseenter', () => tlSelect(i, false));
          n.addEventListener('keydown', (e: KeyboardEvent) => {
            let t: number | null = null;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') t = (i + 1) % tlNodes.length;
            else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') t = (i - 1 + tlNodes.length) % tlNodes.length;
            else if (e.key === 'Home') t = 0;
            else if (e.key === 'End') t = tlNodes.length - 1;
            if (t !== null) { e.preventDefault(); tlSelect(t, true); }
          });
        });
        tlSelect(0, false);
      }
    </script>

    <h2 id="what-not" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">What this project is not</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      To be specific about where the boundaries are:
    </p>

    <ul class="mt-4 space-y-3">
      {notScope.map(s => (
        <li class="flex gap-3 text-gray-600 leading-relaxed">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-300" aria-hidden="true"></span>
          <span>{s}</span>
        </li>
      ))}
    </ul>

    <h2 id="tool-agnostic" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">Why the framework is tool-agnostic</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The framework targets practices rather than products. Its principles are
      claims about what has to be true of a workflow, not about which vendor you
      buy from, so they stay useful as tools come and go and across a community
      that does not share one stack. Where specific tools appear, they appear as
      examples.
    </p>

    <h2 id="where-next" class="mt-12 scroll-mt-8 text-xl font-semibold text-gray-900">Where to go next</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The <a href={`${base}framework/`} class="text-blue-600 hover:underline">framework</a> develops
      the principles in depth and says where the checks go. The <a href={`${base}glossary/`} class="text-blue-600 hover:underline">glossary</a> defines
      the vocabulary used across the project, including the key terms on this page.
    </p>

    <div class="mt-8 rounded-lg bg-gray-50 border border-gray-200 px-5 py-4">
      <p class="text-sm text-gray-600 leading-relaxed">
        <strong class="text-gray-900">A note on institutional policy.</strong>{' '}
        Always follow your institution’s current guidance on AI-tool use —
        especially in sensitive roles. Tools and policies are both evolving
        quickly, and this site is not a substitute for either.
      </p>
    </div>
      </div>
    </div>

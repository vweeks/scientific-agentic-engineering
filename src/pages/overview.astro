---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const modes = [
  {
    name: 'Tab-complete',
    where: 'In your editor',
    what: 'Your editor suggests the rest of the line or block it predicts you are writing, and you accept it or keep typing.',
  },
  {
    name: 'Chat assistant',
    where: 'In a chat window',
    what: 'You work in a separate chat window — describing the problem, pasting in code or an error message, copying the answer back by hand. Nothing moves between the chat and your editor on its own.',
  },
  {
    name: 'Tool use',
    where: 'In a coding assistant',
    what:
      'The assistant runs real tools rather than working only from what it can recall — reading a file, querying a dataset, running a command. Skills package routine commands, MCP servers standardize access to outside systems and data, and plugins or a marketplace make either easy to install.',
  },
  {
    name: 'Planning mode',
    where: 'In a coding assistant',
    what: 'From a goal you state, the assistant works out how it would reach it and shows you the plan before acting. You decide whether it is what you want and who carries it out — which need not be the same assistant that drew up the plan.',
  },
  {
    name: 'Autonomous agent teams',
    where: 'In a coding assistant',
    what:
      'Long-running agents take on broad, multi-step tasks with little supervision, breaking the work apart and coordinating sub-agents to do it. You set the goal and check the result; comparatively little sits in between. It is the most convenient way to work and the easiest place to lose track of what was actually decided.',
  },
];

const failureModes = [
  'Unit confusion',
  'Precision loss',
  'Subtle physics violations',
  'Visualization misinterpretation',
];

const traps = [
  {
    name: 'Context bloat',
    line: 'More context is not more signal.',
    body:
      'Long sessions drift as the window fills. Details you established early get buried, and nothing warns you when they do.',
  },
  {
    name: 'Over-trust',
    line: 'Fluent is not correct.',
    body:
      'Confident output that is quietly wrong is an easy failure to miss, because nothing in the tone of an answer tells you whether you are looking at one.',
  },
];

const pollAxes = [
  { key: 'familiarity', label: 'Familiarity', left: 'Just hearing about them', right: 'Know them well' },
  { key: 'adoption', label: 'Adoption', left: 'Not using them', right: 'Part of daily work' },
  { key: 'skepticism', label: 'Skepticism', left: 'Convinced', right: 'Deeply skeptical' },
  { key: 'overwhelm', label: 'Keeping up', left: 'Comfortably', right: 'Underwater' },
];

const deliverables = [
  {
    name: 'The Framework',
    when: 'July 2026',
    body:
      'Tool-agnostic guidance for structuring agents, skills, and MCP servers in scientific workflows, organized around validation loops, human oversight, and domain-specific safeguards.',
  },
  {
    name: 'The Community Repository',
    when: 'October 2026',
    body:
      'A starter set of scientific MCP server templates, skills such as unit checkers and conservation-law validators, and agent configuration examples.',
  },
  {
    name: 'The Reference Workflow',
    when: 'October 2026',
    body:
      'A structured exercise: build a small weather-model error-statistics application with the AI tooling of your choice, and practice catching documented failure modes while you do it.',
  },
  {
    name: 'Tutorials and workshops',
    when: 'January and April 2027',
    body:
      'Hands-on tutorials and live workshops on using AI agents effectively in scientific work, following the reference workflow, with real-time Q&A — recorded and published for anyone who cannot attend.',
  },
];

const notScope = [
  'It produces guidance and educational resources. It does not produce production-grade AI tools, and it does not maintain long-term software infrastructure.',
  '“Comprehensive methodology” means structured and principled. It does not mean exhaustive coverage of every scientific domain or every AI tool.',
  'The Community Repository is a curated starter set that demonstrates good practice. It is not a package registry or a software distribution platform.',
  'The project does not cover new numerical weather prediction models, commercially deployable agent systems, or maintenance of contributed tools beyond April 2027.',
];
---

<BaseLayout
  title="Overview — Scientific Agentic Engineering"
  description="What Scientific Agentic Engineering is for: the failure modes AI agents introduce in scientific software, the ways people work with these tools, and what this fellowship is and is not building."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900">Overview</h1>

    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      AI coding agents got good quickly, and research software teams are already
      using them. The productivity is real, and so is the risk: scientific
      software can fail in ways that general-purpose tooling was never built to
      catch.
    </p>

    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      This fellowship teaches research software engineers to practice
      AI-augmented engineering effectively and safely — not simply to check an
      agent's output more carefully, but to work in ways that keep errors from
      slipping through in the first place. That means covering the kinds of AI
      tools available, the approaches that get the most out of them safely, and
      the classes of error those approaches are designed to mitigate.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Why scientific code is different</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      When code makes a wrong assumption — whether a person or an agent
      introduced it — the problem in ordinary software is usually apparent: the
      build breaks, a test fails, something looks off on screen. Scientific
      software can fail more quietly, and more dangerously. The code runs, the
      tests pass, and you are left with <strong class="text-gray-900">corrupted results that still pass CI</strong> —
      a green test suite sitting on top of a physically meaningless answer. These
      are also the mistakes easiest to miss when reviewing AI-written code,
      because they are often not mistakes you would introduce yourself, and so
      not the kind review habits are tuned to catch:
    </p>

    <ul class="mt-4 flex flex-wrap gap-2">
      {failureModes.map(m => (
        <li class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">{m}</li>
      ))}
    </ul>

    <p class="mt-4 text-gray-600 leading-relaxed">
      Reproducibility erodes the same way, and more quietly. A result nobody can
      reconstruct is a result that cannot be defended.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Where people stand</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      Research software has not settled on these tools, and reactions to them do
      not sort into two camps. People differ, among other things, in how
      familiar they are with the tools, how far they have adopted them, how
      skeptical they remain, and how
      overwhelmed the pace of change leaves them feeling — some are simply
      waiting for the whole thing to pass, the way earlier fads did.
    </p>

    <div id="standing-poll" class="mt-6 rounded-lg border border-gray-200 p-5" hidden>
      <div class="flex items-baseline justify-between gap-3 flex-wrap">
        <h3 class="font-semibold text-gray-900">Place yourself</h3>
        <span id="poll-count" class="text-xs uppercase tracking-wide text-gray-400"></span>
      </div>
      <p class="mt-1 text-sm text-gray-600 leading-relaxed">
        Four sliders, no right answers. Responses are anonymous — what is
        recorded is the slider positions and the day they arrived, nothing
        that identifies you.
      </p>
      <div class="mt-5 space-y-5">
        {pollAxes.map(({ key, label, left, right }) => (
          <div>
            <div class="flex items-baseline justify-between gap-2">
              <span class="text-xs text-gray-400">{left}</span>
              <span class="text-sm font-medium text-gray-700">{label}</span>
              <span class="text-xs text-gray-400 text-right">{right}</span>
            </div>
            <input type="range" min="0" max="100" value="50" data-axis={key} aria-label={label} class="mt-2 w-full accent-blue-600" />
            <p class="mt-1 text-xs text-blue-600" data-avg-for={key} hidden></p>
          </div>
        ))}
      </div>
      <div class="mt-5 flex items-center gap-4 flex-wrap">
        <button id="poll-submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50 disabled:hover:bg-blue-600">
          Add your response
        </button>
        <p id="poll-status" class="text-sm text-gray-500" aria-live="polite"></p>
      </div>
    </div>

    <script>
      const ENDPOINT = 'https://sae-overview-poll.vweeks-c17.workers.dev';
      const DONE_KEY = 'sae-overview-poll-done';
      const root = document.getElementById('standing-poll');
      const btn = document.getElementById('poll-submit');
      const statusEl = document.getElementById('poll-status');

      function showAverages(averages: Record<string, number | null> | null, count: number) {
        const countEl = document.getElementById('poll-count');
        if (countEl && count > 0) countEl.textContent = `${count} response${count === 1 ? '' : 's'} so far`;
        if (!averages || !root) return;
        for (const [axis, avg] of Object.entries(averages)) {
          if (avg == null) continue;
          const label = root.querySelector<HTMLElement>(`[data-avg-for="${axis}"]`);
          if (label) {
            label.textContent = `community average: ${avg}`;
            label.hidden = false;
          }
        }
      }

      function markDone(message: string) {
        if (!root || !btn || !statusEl) return;
        root.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(i => (i.disabled = true));
        (btn as HTMLButtonElement).disabled = true;
        statusEl.textContent = message;
      }

      function alreadyDone(): boolean {
        try { return localStorage.getItem(DONE_KEY) === '1'; } catch { return false; }
      }

      async function init() {
        if (!root) return;
        let data;
        try {
          const res = await fetch(`${ENDPOINT}/aggregate`);
          if (!res.ok) return; // backend down or retired: leave the widget hidden
          data = await res.json();
        } catch { return; }
        root.hidden = false;
        showAverages(data.averages, data.count);
        if (alreadyDone()) markDone('You have already added yours.');
      }

      async function submit() {
        if (!root || !btn || !statusEl) return;
        (btn as HTMLButtonElement).disabled = true;
        const body: Record<string, number> = {};
        root.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(i => {
          if (i.dataset.axis) body[i.dataset.axis] = Number(i.value);
        });
        try {
          const res = await fetch(`${ENDPOINT}/response`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (res.status === 429) {
            markDone('Daily limit reached from your network — try again tomorrow.');
            return;
          }
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          try { localStorage.setItem(DONE_KEY, '1'); } catch { /* private mode */ }
          showAverages(data.averages, data.count);
          markDone('Thanks — added.');
        } catch {
          (btn as HTMLButtonElement).disabled = false;
          statusEl.textContent = 'Could not reach the poll service — your response may not have been recorded.';
        }
      }

      btn?.addEventListener('click', submit);
      init();
    </script>

    <p class="mt-3 text-gray-600 leading-relaxed">
      This project is aimed at that whole range, not one point on it. Wherever
      you fall, the aim is to help: more fluency with the tools for those who
      want it, and a disciplined skepticism for those who need it instead.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Five ways people work with AI on code</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      These arrived roughly in the order below, which is why they are often
      described as stages. They are not stages, and further down the list is not
      necessarily better. Each one arrived without retiring the one before it, and
      many people move between them by task — laying groundwork with an agent and
      then going back over the details by hand is an ordinary afternoon, not a
      regression.
    </p>

    <p class="mt-3 text-gray-600 leading-relaxed">
      It also matters that <strong class="text-gray-900">agency is a matter of degree, not a category</strong>.
      A coding assistant such as Claude Code or Codex can be driven at any of the
      last three levels. What separates them is how you use it, not which one you
      installed.
    </p>

    <div class="mt-6 space-y-5">
      {modes.map(({ name, where, what }, i) => (
        <div class="border-l-4 border-blue-100 pl-5 py-1">
          <div class="flex items-baseline gap-3 flex-wrap">
            <h3 class="font-semibold text-gray-900">
              <span class="text-blue-600 tabular-nums">{i + 1}.</span> {name}
            </h3>
            <span class="text-xs uppercase tracking-wide text-gray-400">{where}</span>
          </div>
          <p class="mt-1 text-gray-600 leading-relaxed">{what}</p>
        </div>
      ))}
    </div>

    <p class="mt-6 text-gray-600 leading-relaxed">
      What changes down the list is how much of the work proceeds without an
      active decision from you. Watching a session scroll past is not the same as
      deciding anything, and once sub-agents are running in parallel, keeping up
      with all of them becomes considerably more taxing. Where to spend your
      attention, and what to check when you cannot spend it, is what the <a href={`${base}framework/`} class="text-blue-600 hover:underline">framework</a> is for.
    </p>

    <h3 class="mt-10 font-semibold text-gray-900">Two risks that do not depend on which one you pick</h3>

    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {traps.map(({ name, line, body }) => (
        <div class="rounded-lg border border-gray-200 p-5">
          <h4 class="font-semibold text-gray-900">{name}</h4>
          <p class="mt-1 text-sm font-medium text-blue-600">{line}</p>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">What this project is building</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The fellowship runs from April 2026 to April 2027 and produces four things.
    </p>

    <dl class="mt-5 space-y-5">
      {deliverables.map(({ name, when, body }) => (
        <div>
          <dt class="flex items-baseline gap-3 flex-wrap">
            <span class="font-semibold text-gray-900">{name}</span>
            <span class="text-xs uppercase tracking-wide text-gray-400">{when}</span>
          </dt>
          <dd class="mt-1 text-gray-600 leading-relaxed">{body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-6 text-gray-600 leading-relaxed">
      The aim throughout is to turn broad AI capability into reliable development
      instruments: tools a scientist can point at real work and trust the output
      of, for reasons they can articulate.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">What this project is not</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      This is a project about guidance and education, not a software product. To
      be specific about where the boundaries are:
    </p>

    <ul class="mt-4 space-y-3">
      {notScope.map(s => (
        <li class="flex gap-3 text-gray-600 leading-relaxed">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-300" aria-hidden="true"></span>
          <span>{s}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Why the framework is tool-agnostic</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      This project’s subject matter changes underneath it. MCP specifications take
      breaking changes. Agent frameworks get rewritten. Tools named in a document
      written today may be deprecated or superseded before the fellowship ends.
    </p>

    <p class="mt-3 text-gray-600 leading-relaxed">
      So the framework commits to principles rather than products. Validation
      loops, human oversight, and domain-specific safeguards are claims about what
      has to be true of a workflow, not about which vendor you buy from, and they
      should still hold once the current generation of tools is gone. Where
      specific tools appear, they appear as examples.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Where to go next</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The <a href={`${base}framework/`} class="text-blue-600 hover:underline">framework</a> develops
      the principles in depth and says where the checks go. The <a href={`${base}glossary/`} class="text-blue-600 hover:underline">glossary</a> defines
      the vocabulary used across the project, including the key terms on this page.
    </p>

    <div class="mt-8 rounded-lg bg-gray-50 border border-gray-200 px-5 py-4">
      <p class="text-sm text-gray-600 leading-relaxed">
        <strong class="text-gray-900">A note on institutional policy.</strong>
        Always follow your institution’s current guidance on AI-tool use —
        especially in sensitive roles. Tools and policies are both evolving
        quickly, and this site is not a substitute for either.
      </p>
    </div>
  </div>
</BaseLayout>

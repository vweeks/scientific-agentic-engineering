---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const modes = [
  {
    name: 'Tab-complete',
    where: 'In your editor',
    what: 'Your editor suggests the rest of the line or block it predicts you are writing, and you accept it or keep typing.',
  },
  {
    name: 'Chat assistant',
    where: 'In a chat window',
    what: 'You work in a separate chat window — describing the problem, pasting in code or an error message, copying the answer back by hand. Nothing moves between the chat and your editor on its own.',
  },
  {
    name: 'Tool use',
    where: 'In a coding assistant',
    what:
      'The assistant runs real tools rather than working only from what it can recall — reading a file, querying a dataset, running a command. Skills package routine commands, MCP servers standardize access to outside systems and data, and plugins or a marketplace make either easy to install.',
  },
  {
    name: 'Planning mode',
    where: 'In a coding assistant',
    what: 'From a goal you state, the assistant works out how it would reach it and shows you the plan before acting. You decide whether it is what you want and who carries it out — which need not be the same assistant that drew up the plan.',
  },
  {
    name: 'Autonomous agent teams',
    where: 'In a coding assistant',
    what:
      'Long-running agents take on broad, multi-step tasks with little supervision, breaking the work apart and coordinating sub-agents to do it. You set the goal and check the result; comparatively little sits in between. It is the most convenient way to work and the easiest place to lose track of what was actually decided.',
  },
];

const failureModes = [
  'Unit confusion',
  'Precision loss',
  'Subtle physics violations',
  'Visualization misinterpretation',
];

const traps = [
  {
    name: 'Context bloat',
    line: 'More context is not more signal.',
    body:
      'Long sessions drift as the window fills. Details you established early get buried, and nothing warns you when they do.',
  },
  {
    name: 'Over-trust',
    line: 'Fluent is not correct.',
    body:
      'Confident output that is quietly wrong is an easy failure to miss, because nothing in the tone of an answer tells you whether you are looking at one.',
  },
];

// Four facets of where someone stands on AI-augmented development. Three run
// "outward is the direction the project encourages"; trust is centered, where
// the healthy target is the middle (calibrated), not an end. Keys are the
// stable backend contract (see workers/overview-poll) — labels can change
// without a Cloudflare edit; keys cannot.
const pollAxes = [
  { key: 'familiarity', label: 'Familiarity', left: 'Unaware', right: 'Fluent', goal: 'up' },
  { key: 'adoption', label: 'Adoption', left: 'Not using', right: 'Daily use', goal: 'up' },
  { key: 'keepingup', label: 'Keeping up', left: 'Overwhelmed', right: 'Steady', goal: 'up' },
  { key: 'trust', label: 'Trust', left: 'Blanket rejection', right: 'Blind trust', mid: 'Calibrated', goal: 'center' },
];
const POLL_PHASE = 'before';
const POLL_DEFAULT = 50;

// Radar geometry, precomputed so the skeleton renders server-side (styles apply
// cleanly, less client DOM-building). The client script recomputes the two data
// polygons on interaction with the same math. "health" makes further-from-center
// mean the encouraged direction on every axis, including centered trust.
const R_CX = 130, R_CY = 130, R_R = 92;
const radarPt = (i, hv) => {
  const ang = (-90 + i * 90) * Math.PI / 180;
  const r = (hv / 100) * R_R;
  return [R_CX + r * Math.cos(ang), R_CY + r * Math.sin(ang)];
};
const radarHealth = (goal, v) => (goal === 'center' ? 100 - Math.abs(v - 50) * 2 : v);
const fmtPts = (pts) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const radarRings = [25, 50, 75, 100].map(f => fmtPts(pollAxes.map((_, i) => radarPt(i, f))));
const radarSpokes = pollAxes.map((_, i) => radarPt(i, 100));
const radarLabels = pollAxes.map((a, i) => {
  const [x, y] = radarPt(i, 113);
  return {
    label: a.label, x, y,
    anchor: i === 1 ? 'start' : i === 3 ? 'end' : 'middle',
    baseline: i === 0 ? 'auto' : i === 2 ? 'hanging' : 'middle',
  };
});
const radarInit = fmtPts(pollAxes.map((a, i) => radarPt(i, radarHealth(a.goal, POLL_DEFAULT))));
const handleInit = pollAxes.map((a, i) => radarPt(i, radarHealth(a.goal, POLL_DEFAULT)));

const deliverables = [
  {
    name: 'The Framework',
    when: 'July 2026',
    body:
      'Tool-agnostic guidance for structuring agents, skills, and MCP servers in scientific workflows, organized around validation loops, human oversight, and domain-specific safeguards.',
  },
  {
    name: 'The Community Repository',
    when: 'October 2026',
    body:
      'A starter set of scientific MCP server templates, skills such as unit checkers and conservation-law validators, and agent configuration examples.',
  },
  {
    name: 'The Reference Workflow',
    when: 'October 2026',
    body:
      'A structured exercise: build a small weather-model error-statistics application with the AI tooling of your choice, and practice catching documented failure modes while you do it.',
  },
  {
    name: 'Tutorials and workshops',
    when: 'January and April 2027',
    body:
      'Hands-on tutorials and live workshops on using AI agents effectively in scientific work, following the reference workflow, with real-time Q&A — recorded and published for anyone who cannot attend.',
  },
];

const notScope = [
  'It produces guidance and educational resources. It does not produce production-grade AI tools, and it does not maintain long-term software infrastructure.',
  '“Comprehensive methodology” means structured and principled. It does not mean exhaustive coverage of every scientific domain or every AI tool.',
  'The Community Repository is a curated starter set that demonstrates good practice. It is not a package registry or a software distribution platform.',
  'The project does not cover new numerical weather prediction models, commercially deployable agent systems, or maintenance of contributed tools beyond April 2027.',
];
---

<BaseLayout
  title="Overview — Scientific Agentic Engineering"
  description="What Scientific Agentic Engineering is for: the failure modes AI agents introduce in scientific software, the ways people work with these tools, and what this fellowship is and is not building."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900">Overview</h1>

    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      AI coding agents got good quickly, and research software teams are already
      using them. The productivity is real, and so is the risk: scientific
      software can fail in ways that general-purpose tooling was never built to
      catch.
    </p>

    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      This fellowship teaches research software engineers to practice
      AI-augmented engineering effectively and safely — not simply to check an
      agent's output more carefully, but to work in ways that keep errors from
      slipping through in the first place. That means covering the kinds of AI
      tools available, the approaches that get the most out of them safely, and
      the classes of error those approaches are designed to mitigate.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Why scientific code is different</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      When code makes a wrong assumption — whether a person or an agent
      introduced it — the problem in ordinary software is usually apparent: the
      build breaks, a test fails, something looks off on screen. Scientific
      software can fail more quietly, and more dangerously. The code runs, the
      tests pass, and you are left with <strong class="text-gray-900">corrupted results that still pass CI</strong> —
      a green test suite sitting on top of a physically meaningless answer. They
      are also among the easiest to miss when reviewing AI-written code: an agent
      does not make the mistakes you would make yourself, so they slip past the
      instincts a reviewer leans on. A few of the classes worth watching for:
    </p>

    <ul class="mt-4 flex flex-wrap gap-2">
      {failureModes.map(m => (
        <li class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">{m}</li>
      ))}
    </ul>

    <p class="mt-4 text-gray-600 leading-relaxed">
      Reproducibility erodes the same way, and more quietly. A result nobody can
      reconstruct is a result that cannot be defended.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Where people stand</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      Research software has not settled on these tools, and reactions to them are
      not binary. People differ, among other things, in how familiar they are
      with the tools, how far they have adopted them, how well their trust is
      calibrated, and how steady they feel amid the pace of change.
    </p>

    <div id="standing-poll" class="mt-6 rounded-lg border border-gray-200 p-5" data-phase={POLL_PHASE} hidden>
      <div class="flex items-baseline justify-between gap-3 flex-wrap">
        <h3 class="font-semibold text-gray-900">Place yourself</h3>
        <span id="poll-count" class="text-xs uppercase tracking-wide text-gray-400"></span>
      </div>
      <p class="mt-1 text-sm text-gray-600 leading-relaxed">
        Anonymously rate your own sentiment toward AI-augmented development
        tools. Whatever your starting point, this project hopes to widen your
        coverage on every axis.
      </p>

      <div class="poll-rig mt-5">
        <div class="poll-radar-wrap">
          <svg class="poll-radar" viewBox="-40 -40 340 340" role="img" aria-label="A four-axis shape of your response. Further from the center is the direction this project encourages: more familiarity, more adoption, steadier footing, and calibrated trust.">
            <g>
              {radarRings.map((pts, idx) => (
                <polygon points={pts} class={idx === radarRings.length - 1 ? 'poll-ring poll-ring--outer' : 'poll-ring'} />
              ))}
              {radarSpokes.map(([x, y]) => (
                <line x1={R_CX} y1={R_CY} x2={x.toFixed(1)} y2={y.toFixed(1)} class="poll-spoke" />
              ))}
            </g>
            <polygon class="poll-poly-community" points="" hidden></polygon>
            <polygon class="poll-poly-you" points={radarInit}></polygon>
            <g class="poll-handles">
              {handleInit.map(([x, y]) => (
                <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="3.5" class="poll-handle" />
              ))}
            </g>
            <g>
              {radarLabels.map(({ label, x, y, anchor, baseline }) => (
                <text x={x.toFixed(1)} y={y.toFixed(1)} text-anchor={anchor} dominant-baseline={baseline}>{label}</text>
              ))}
            </g>
          </svg>
          <p class="poll-goal-note">Further out = the direction this project encourages.</p>
        </div>

        <div class="poll-axes">
          {pollAxes.map(({ key, label, left, right, mid, goal }) => (
            <div class={goal === 'center' ? 'poll-axis poll-axis--center' : 'poll-axis'}>
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-xs text-gray-400">{left}</span>
                <span class="text-sm font-medium text-gray-700">{label}{mid && <span class="poll-target"> ▸ {mid}</span>}</span>
                <span class="text-xs text-gray-400 text-right">{right}</span>
              </div>
              <input type="range" min="0" max="100" value={POLL_DEFAULT} data-axis={key} data-goal={goal}
                     aria-label={mid ? `${label}: ${left} to ${right}, healthy at the center (${mid})` : `${label}: ${left} to ${right}`}
                     class="poll-range mt-2 w-full" />
            </div>
          ))}
        </div>
      </div>

      <div class="mt-5 flex items-center gap-4 flex-wrap">
        <button id="poll-submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50 disabled:hover:bg-blue-600">
          Add your response
        </button>
        <p id="poll-status" class="text-sm text-gray-500" aria-live="polite"></p>
      </div>
    </div>

    <script define:vars={{
      axes: pollAxes.map(a => ({ key: a.key, goal: a.goal })),
      phase: POLL_PHASE,
      CX: R_CX, CY: R_CY, RAD: R_R,
      endpoint: 'https://sae-overview-poll.vweeks-c17.workers.dev',
    }}>
      const root = document.getElementById('standing-poll');
      const btn = document.getElementById('poll-submit');
      const statusEl = document.getElementById('poll-status');
      const countEl = document.getElementById('poll-count');

      if (root && btn) {
        const polyYou = root.querySelector('.poll-poly-you');
        const polyCommunity = root.querySelector('.poll-poly-community');
        const handles = root.querySelectorAll('.poll-handle');
        const ranges = root.querySelectorAll('input[type="range"]');
        const DONE_KEY = `sae-overview-poll-done-${phase}`;

        const health = (goal, v) => (goal === 'center' ? 100 - Math.abs(v - 50) * 2 : v);
        const pt = (i, hv) => {
          const a = (-90 + i * 90) * Math.PI / 180, r = (hv / 100) * RAD;
          return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
        };
        const pointsFrom = (valueOf) =>
          axes.map((ax, i) => pt(i, health(ax.goal, valueOf(ax.key))).map(n => n.toFixed(1)).join(',')).join(' ');

        const state = {};
        axes.forEach((ax, i) => { state[ax.key] = Number(ranges[i].value); });

        function renderYou() {
          polyYou.setAttribute('points', pointsFrom(k => state[k]));
          axes.forEach((ax, i) => {
            const [x, y] = pt(i, health(ax.goal, state[ax.key]));
            handles[i].setAttribute('cx', x.toFixed(1));
            handles[i].setAttribute('cy', y.toFixed(1));
          });
        }
        ranges.forEach(inp => inp.addEventListener('input', () => {
          state[inp.dataset.axis] = Number(inp.value);
          renderYou();
        }));
        renderYou();

        function showCommunity(averages) {
          if (!averages || !axes.every(ax => averages[ax.key] != null)) return;
          polyCommunity.setAttribute('points', pointsFrom(k => averages[k]));
          polyCommunity.hidden = false;
        }
        function setCount(n) {
          if (countEl && n > 0) countEl.textContent = `${n} response${n === 1 ? '' : 's'} so far`;
        }
        function markDone(message) {
          ranges.forEach(i => (i.disabled = true));
          btn.disabled = true;
          if (statusEl) statusEl.textContent = message;
        }
        const alreadyDone = () => {
          try { return localStorage.getItem(DONE_KEY) === '1'; } catch { return false; }
        };

        async function init() {
          let data;
          try {
            const res = await fetch(`${endpoint}/aggregate`);
            if (!res.ok) return; // backend down or retired: leave the widget hidden
            data = await res.json();
          } catch { return; }
          const mine = data?.phases?.[phase] || { count: 0, averages: null };
          root.hidden = false;
          setCount(mine.count);
          if (alreadyDone()) { showCommunity(mine.averages); markDone('You have already added yours.'); }
        }

        async function submit() {
          btn.disabled = true;
          const body = { phase };
          ranges.forEach(i => { if (i.dataset.axis) body[i.dataset.axis] = Number(i.value); });
          try {
            const res = await fetch(`${endpoint}/response`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (res.status === 429) {
              markDone('Daily limit reached from your network — try again tomorrow.');
              return;
            }
            if (!res.ok) throw new Error(String(res.status));
            const data = await res.json();
            try { localStorage.setItem(DONE_KEY, '1'); } catch { /* private mode */ }
            const mine = data?.phases?.[phase];
            if (mine) { setCount(mine.count); showCommunity(mine.averages); }
            markDone('Thanks — added.');
          } catch {
            btn.disabled = false;
            if (statusEl) statusEl.textContent = 'Could not reach the poll service — your response may not have been recorded.';
          }
        }

        btn.addEventListener('click', submit);
        init();
      }
    </script>

    <p class="mt-3 text-gray-600 leading-relaxed">
      This project is aimed at that whole spread, not one point in it. Wherever
      you land, the aim is the same push: more familiarity and adoption where
      they help, trust that is calibrated rather than blind or absent, and enough
      steadiness to keep up without drowning.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Five ways people work with AI on code</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      These arrived roughly in the order below, which is why they are often
      described as stages. They are not stages, and further down the list is not
      necessarily better. Each one arrived without retiring the one before it, and
      many people move between them by task — laying groundwork with an agent and
      then going back over the details by hand is an ordinary afternoon, not a
      regression.
    </p>

    <p class="mt-3 text-gray-600 leading-relaxed">
      It also matters that <strong class="text-gray-900">agency is a matter of degree, not a category</strong>.
      A coding assistant such as Claude Code or Codex can be driven at any of the
      last three levels. What separates them is how you use it, not which one you
      installed.
    </p>

    <div class="mt-6 space-y-5">
      {modes.map(({ name, where, what }, i) => (
        <div class="border-l-4 border-blue-100 pl-5 py-1">
          <div class="flex items-baseline gap-3 flex-wrap">
            <h3 class="font-semibold text-gray-900">
              <span class="text-blue-600 tabular-nums">{i + 1}.</span> {name}
            </h3>
            <span class="text-xs uppercase tracking-wide text-gray-400">{where}</span>
          </div>
          <p class="mt-1 text-gray-600 leading-relaxed">{what}</p>
        </div>
      ))}
    </div>

    <p class="mt-6 text-gray-600 leading-relaxed">
      What changes down the list is how much of the work proceeds without an
      active decision from you. Watching a session scroll past is not the same as
      deciding anything, and once sub-agents are running in parallel, keeping up
      with all of them becomes considerably more taxing. Where to spend your
      attention, and what to check when you cannot spend it, is what the <a href={`${base}framework/`} class="text-blue-600 hover:underline">framework</a> is for.
    </p>

    <h3 class="mt-10 font-semibold text-gray-900">Two risks that do not depend on which one you pick</h3>

    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {traps.map(({ name, line, body }) => (
        <div class="rounded-lg border border-gray-200 p-5">
          <h4 class="font-semibold text-gray-900">{name}</h4>
          <p class="mt-1 text-sm font-medium text-blue-600">{line}</p>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">What this project is building</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The fellowship runs from April 2026 to April 2027 and produces four things.
    </p>

    <dl class="mt-5 space-y-5">
      {deliverables.map(({ name, when, body }) => (
        <div>
          <dt class="flex items-baseline gap-3 flex-wrap">
            <span class="font-semibold text-gray-900">{name}</span>
            <span class="text-xs uppercase tracking-wide text-gray-400">{when}</span>
          </dt>
          <dd class="mt-1 text-gray-600 leading-relaxed">{body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-6 text-gray-600 leading-relaxed">
      The aim throughout is to turn broad AI capability into reliable development
      instruments: tools a scientist can point at real work and trust the output
      of, for reasons they can articulate.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">What this project is not</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      This is a project about guidance and education, not a software product. To
      be specific about where the boundaries are:
    </p>

    <ul class="mt-4 space-y-3">
      {notScope.map(s => (
        <li class="flex gap-3 text-gray-600 leading-relaxed">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-300" aria-hidden="true"></span>
          <span>{s}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Why the framework is tool-agnostic</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The framework is tool-agnostic by design. Whichever tools you favor — and
      however fast the landscape shifts around them — it aims at practices that
      hold in general rather than at any single product. That keeps it useful as
      tools come and go, and useful across the community rather than only to
      whoever happens to share your stack.
    </p>

    <p class="mt-3 text-gray-600 leading-relaxed">
      That is why the framework commits to principles rather than products.
      Validation loops, human oversight, and domain-specific safeguards are claims
      about what has to be true of a workflow, not about which vendor you buy
      from. Where specific tools appear, they appear as examples.
    </p>

    <h2 class="mt-12 text-xl font-semibold text-gray-900">Where to go next</h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      The <a href={`${base}framework/`} class="text-blue-600 hover:underline">framework</a> develops
      the principles in depth and says where the checks go. The <a href={`${base}glossary/`} class="text-blue-600 hover:underline">glossary</a> defines
      the vocabulary used across the project, including the key terms on this page.
    </p>

    <div class="mt-8 rounded-lg bg-gray-50 border border-gray-200 px-5 py-4">
      <p class="text-sm text-gray-600 leading-relaxed">
        <strong class="text-gray-900">A note on institutional policy.</strong>
        Always follow your institution’s current guidance on AI-tool use —
        especially in sensitive roles. Tools and policies are both evolving
        quickly, and this site is not a substitute for either.
      </p>
    </div>
  </div>

  <style is:global>
    /* "Where people stand" poll — namespaced under #standing-poll so nothing
       leaks to the rest of the page. Palette matches the site's gray/blue. */
    #standing-poll .poll-rig { display: grid; gap: 1.3rem; align-items: center; }
    @media (min-width: 640px) {
      #standing-poll .poll-rig { grid-template-columns: 250px 1fr; gap: 1.5rem; }
    }
    #standing-poll .poll-radar-wrap { display: flex; flex-direction: column; align-items: center; gap: .4rem; }
    #standing-poll .poll-radar { width: 100%; max-width: 250px; height: auto; }
    #standing-poll .poll-ring { fill: none; stroke: #e5e7eb; stroke-width: 1; }
    #standing-poll .poll-ring--outer { stroke: #2563eb; stroke-opacity: .5; stroke-width: 1.3; }
    #standing-poll .poll-spoke { stroke: #e5e7eb; stroke-width: 1; }
    #standing-poll .poll-labels { pointer-events: none; }
    #standing-poll .poll-radar text { fill: #6b7280; font-size: 13px; font-weight: 600; font-family: inherit; }
    #standing-poll .poll-poly-you { fill: #2563eb; fill-opacity: .16; stroke: #2563eb; stroke-width: 2; }
    #standing-poll .poll-handle { fill: #2563eb; }
    #standing-poll .poll-poly-community { fill: #9ca3af; fill-opacity: .12; stroke: #9ca3af; stroke-width: 1.5; stroke-dasharray: 4 3; }
    #standing-poll .poll-goal-note { font-size: .7rem; color: #9ca3af; text-align: center; margin: 0; max-width: 30ch; }
    #standing-poll .poll-axes { display: flex; flex-direction: column; gap: 1.1rem; }
    #standing-poll .poll-target { color: #059669; font-weight: 600; font-size: .72em; white-space: nowrap; }

    #standing-poll .poll-range { -webkit-appearance: none; appearance: none; height: 20px; background: transparent; cursor: pointer; }
    #standing-poll .poll-range::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: #e5e7eb; }
    #standing-poll .poll-range::-moz-range-track { height: 4px; border-radius: 4px; background: #e5e7eb; }
    #standing-poll .poll-range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 18px; height: 18px; margin-top: -7px; border-radius: 50%; background: #2563eb; border: 2px solid #fff; box-shadow: 0 0 0 1px #2563eb; }
    #standing-poll .poll-range::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #2563eb; border: 2px solid #fff; box-shadow: 0 0 0 1px #2563eb; }
    #standing-poll .poll-range:focus-visible { outline: none; }
    #standing-poll .poll-range:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 3px #dbeafe, 0 0 0 4px #2563eb; }
    #standing-poll .poll-range:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 3px #dbeafe, 0 0 0 4px #2563eb; }
    /* centered trust axis: tint the healthy middle of the track */
    #standing-poll .poll-axis--center .poll-range::-webkit-slider-runnable-track { background: linear-gradient(90deg, #e5e7eb 0 33%, #9ad0c0 45% 55%, #e5e7eb 67% 100%); }
